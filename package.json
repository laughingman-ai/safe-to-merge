{
  "name": "safe-to-merge",
  "version": "0.1.0",
  "private": true,
  "description": "A working demo of the checks that make AI coding agents safe to merge.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check --log-level warn .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:hooks": "node --test --test-reporter=spec \"hooks/test/*.test.mjs\"",
    "check:test-lock": "node scripts/check-test-lock.mjs",
    "verify": "node scripts/verify.mjs",
    "replay": "bash demo/replay.sh",
    "review": "bash scripts/review.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
